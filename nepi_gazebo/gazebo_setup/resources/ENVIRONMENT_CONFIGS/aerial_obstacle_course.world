<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Brighter global ambient light: Gazebo stock model://sun plus
         no explicit <scene> left the whole world reading as very
         dark/flat (Gazebo own unspecified-scene ambient default is
         0.4 0.4 0.4 1). Requested live (2026-09-17): "everything is
         really dark in the quadcopter sim, same for in the rover
         sim." Raised ambient/background here rather than editing the
         stock sun model itself, so this applies uniformly regardless
         of which world is loaded. -->
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>true</shadows>
    </scene>
    <gui>
      <camera name="user_camera">
        <pose>-5 0 1 0 0.2 0</pose>
      </camera>
    </gui>
    <!-- Physics block mirrors the ArduPilot iris_arducopter_cmac.world
         this setup used to ship (since removed), including the
         real_time_update_rate cap (1000) -- do not remove it, an uncapped
         physics rate pins the CPU and runs the sim faster than real time.
         Deviation from that iris world: contact_max_correcting_vel /
         contact_surface_layer use Gazebo defaults (100 / 0.001) instead of
         the iris values (0.1 / 0.0) -- those drone-tuned values let a
         wheeled vehicle sink into the ground plane so the wheels never
         grip (rover crawled at ~1/10 of commanded speed). -->
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Inlined rather than `<include><uri>model://ground_plane</uri></include>`
         so the material can be swapped to something with visible texture --
         collision/friction (mu=100/mu2=50) copied verbatim from the stock
         ground_plane model so the wheel-grip tuning above isn't affected.
         Plain Gazebo/Grey made rover motion almost impossible to judge by eye
         (no visual reference points on a flat grey plane); Gazebo/Grass gives
         a textured, high-contrast backdrop without adding any actual terrain
         complexity. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <contact>
              <collide_bitmask>0xffff</collide_bitmask>
            </contact>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grass</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- The generic_rover include that used to sit here was removed
         2026-09-18. Files in ENVIRONMENT_CONFIGS are SCENERY ONLY: the robot
         is now whatever robot config is selected, which nepi_gazebo.sh spawns
         into the running world after start. Leaving the rover included here
         would put a second, unselectable one in the world next to the spawned
         one. The model itself moved to ROBOT_CONFIGS/generic_rover.

         The note that used to be here is preserved because it is still the
         governing constraint, it just applies in ROBOT_CONFIGS now: an
         include must never be wrapped in an outer model element. Found live
         2026-08-18 under Gazebo Classic 11, that wrapping double-loads the
         included model's plugins, confirmed via "Tried to advertise a service
         that is already advertised in this node
         [/rover/camera/set_parameters]" plus the DiffDrive plugin's own
         startup log lines appearing twice per launch, and both camera topics
         ending up with NO active publisher at all afterward despite the model
         existing in get_world_properties. That is almost certainly the actual
         mechanism behind the long-reported "can't see some of the cameras in
         the robot viewer": not a topic-discovery or RUI bug, the publisher
         genuinely is not there. See ROBOT_CONFIGS/README.md. -->

    <!-- The follow-cam rig used to be spawned here as a standalone model,
         repositioned every frame via /gazebo/set_model_state by
         camera_rig_controller.py -- that per-frame kinematic follow had an
         inherent lag (odom update -> controller tick -> reposition, three
         independent async loops). Both the first-person and chase cameras
         are now rigid links welded directly onto generic_rover itself
         (camera_link / camera_link_chase in generic_rover/model.sdf), so
         there is nothing left to spawn or follow here. -->
    <!-- Aerial Obstacle Course environment (added 2026-09-29): flat.world plus the
         aerial_obstacle_course model inlined below, so selecting this world from the
         Sim Connector's Environment Config list brings the course up with the
         rover. Inlined rather than <include>d: ENVIRONMENT_CONFIGS worlds are
         self-contained (nepi_gazebo.sh only adds ROBOT_CONFIGS to
         GAZEBO_MODEL_PATH). Geometry copied from nepi_drones
         sim_container/models/aerial_obstacle_course/model.sdf (generated from its
         dimensions.yaml by generate_model_sdf.py); edited geometry from the
         RUI's dimensions editor does not reach this file yet. -->
    <model name="aerial_obstacle_course">
      <!-- Static: pure world geometry, no dynamics needed. Generated by
           generate_model_sdf.py from dimensions.yaml -- edit that file (or the
           curated-fields UI in Sim Connector), not this one directly, unless
           using the raw-SDF-upload escape hatch. -->
      <static>true</static>

      <!-- 4 square gate frames along +x starting at
           course_start_x_m=3.0m, spaced 6.0m apart,
           each opening 2.0m x 2.0m, climbing from
           2.0m up to 5.0m in 1.0m steps -- a
           drone flies up-and-through each gate in order. -->

      <link name="gate_0_top">
        <pose>3.000000 0.000000 3.075000 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box><size>0.150000 2.300000 0.150000</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.150000 2.300000 0.150000</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
      </link>

      <link name="gate_0_bottom">
        <pose>3.000000 0.000000 0.925000 0 0 0</pose>
        <collision name="collision">
