<?xml version="1.0"?>

<model>
  <name>Generic Rover</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Numurus</name>
    <email>nepi@numurus.com</email>
  </author>

  <description>
    Generic differential-drive rover for the NEPI universal simulator bridge
    (Phase 1). Two driven wheels plus front/rear frictionless casters, a
    forward-mounted camera on a mast, gazebo_ros_diff_drive for motion
    (/rover/cmd_vel in, /rover/odom out) and gazebo_ros_camera for vision
    (/rover/camera/image_raw). Built for Gazebo Classic 11 / ROS Noetic.
  </description>
</model>
