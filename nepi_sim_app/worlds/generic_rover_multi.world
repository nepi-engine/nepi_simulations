<?xml version="1.0" ?>
<!-- Multi-robot variant of generic_rover.world (Universal Simulator Bridge,
     Phase 4): two instances of the generic_rover model side by side, each
     with its own ROS namespace (/rover1, /rover2). The model XML is inlined
     twice (generated from models/generic_rover/model.sdf) instead of using
     <include>, because Gazebo Classic 11's <include> cannot override plugin
     parameters per instance: an <include>-level <plugin> element is APPENDED
     to the model as an additional plugin (sdformat raises "Non-unique names
     detected in type plugin" and two diff-drive controllers end up fighting
     over the same wheel joints -- confirmed empirically 2026-07-22), and the
     camera plugin nested inside link/sensor is unreachable from <include>
     level entirely. So per-instance namespaces must be baked into
     per-instance model XML. If models/generic_rover/model.sdf changes,
     regenerate these blocks from it (replacements per instance: model name +
     spawn pose, diff-drive robotNamespace, cameraName, publishOdomTF).

     The same constraint applies to the two camera_rig instances further
     below (camera-rover-multi phase, 2026-07-23), confirmed by a direct
     scratch test rather than assumed: unlike the diff-drive plugin, two
     <include>s of model://camera_rig produce no SDF error at all -- the
     collision is silent, because <cameraName>/<frameName> are literal
     strings in camera_rig/model.sdf unrelated to the <include>'s <name>
     override, so both instances' plugins wrote to the exact same
     /camera_rig/camera/image_raw topic. Inlined here as camera_rig1/
     camera_rig2 with distinct cameraName/frameName for the same reason.
     Deviations from the single-robot model, both instances:
       - robotNamespace /rover1 / /rover2 (vs /rover), cameraName
         rover1/camera / rover2/camera (vs rover/camera) so topics never
         collide between instances
       - publishOdomTF false (vs true): two robots would publish conflicting
         odom->base_link transforms on the shared /tf; nothing in the bridge
         pipeline consumes TF
     The single-robot generic_rover.world is untouched and remains the
     default sim_rover_gazebo workflow. -->
<sdf version="1.6">
  <world name="default">
    <gui>
      <camera name="user_camera">
        <pose>-5 0 1 0 0.2 0</pose>
      </camera>
    </gui>
    <!-- Physics block copied verbatim from generic_rover.world -- see the
         comments there for why real_time_update_rate is capped and why the
         contact constraint values deviate from the iris drone world. -->
    <physics type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>100</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="rover1">
        <pose>0 2 0 0 0 0</pose>

      <!-- Chassis. Origin sits at wheel-axle height (0.15 m) so the wheels
           (r = 0.1 m) and the two frictionless caster spheres all touch the
           ground plane when the model spawns at z = 0. -->
      <link name="base_link">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.0417</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0708</iyy>
            <iyz>0</iyz>
            <izz>0.1042</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.4 0.3 0.1</size>
            </box>
          </geometry>
        </collision>
        <!-- Front / rear casters: frictionless spheres so the two driven
             wheels fully determine the rover's motion. -->
        <collision name="front_caster_collision">
          <pose>0.15 0 -0.10 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="rear_caster_collision">
          <pose>-0.15 0 -0.10 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.4 0.3 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.6 1</ambient>
            <diffuse>0.1 0.3 0.6 1</diffuse>
          </material>
        </visual>
        <visual name="front_caster_visual">
          <pose>0.15 0 -0.10 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="rear_caster_visual">
          <pose>-0.15 0 -0.10 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <!-- Camera mast (visual only) up to the camera_link offset. -->
        <visual name="camera_mast_visual">
          <pose>0.2 0 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.01</radius>
              <length>0.45</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.17 0.1 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.00135</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00135</iyy>
            <iyz>0</iyz>
            <izz>0.0025</izz>
          </inertia>
        </inertial>
        <collision name="left_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="left_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.17 0.1 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.00135</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00135</iyy>
            <iyz>0</iyz>
            <izz>0.0025</izz>
          </inertia>
        </inertial>
        <collision name="right_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="right_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <use_parent_model_frame>true</use_parent_model_frame>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <use_parent_model_frame>true</use_parent_model_frame>
        </axis>
      </joint>

      <!-- Camera at (0.2, 0.0, 0.5) relative to base_link per the plan doc's
           Step 1.1 spec (base_link origin is at z = 0.15 in the model frame,
           so the link pose below is 0.15 + 0.5). -->
      <link name="camera_link">
        <pose>0.2 0 0.65 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00001</iyy>
            <iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <visual name="camera_visual">
          <geometry>
            <box>
              <size>0.04 0.08 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <sensor type="camera" name="rover_camera_sensor">
          <update_rate>15.0</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera name="rover_camera">
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <robotNamespace>/</robotNamespace>
            <cameraName>rover1/camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>camera_link</frameName>
          </plugin>
        </sensor>
      </link>

      <joint name="camera_joint" type="fixed">
        <parent>base_link</parent>
        <child>camera_link</child>
      </joint>

      <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
        <robotNamespace>/rover1</robotNamespace>
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <odometrySource>world</odometrySource>
        <robotBaseFrame>base_link</robotBaseFrame>
        <leftJoint>left_wheel_joint</leftJoint>
        <rightJoint>right_wheel_joint</rightJoint>
        <wheelSeparation>0.34</wheelSeparation>
        <wheelDiameter>0.2</wheelDiameter>
        <wheelTorque>10.0</wheelTorque>
        <!-- 0 disables the plugin's wheel-speed ramp: commanded velocity is
             applied directly. A nonzero ramp made the rover crawl (~10x
             slower than commanded) under this world's physics settings. -->
        <wheelAcceleration>0.0</wheelAcceleration>
        <updateRate>30.0</updateRate>
        <publishOdomTF>false</publishOdomTF>
        <publishWheelTF>false</publishWheelTF>
        <publishWheelJointState>false</publishWheelJointState>
        <legacyMode>false</legacyMode>
      </plugin>

    </model>

    <model name="rover2">
        <pose>0 -2 0 0 0 0</pose>

      <!-- Chassis. Origin sits at wheel-axle height (0.15 m) so the wheels
           (r = 0.1 m) and the two frictionless caster spheres all touch the
           ground plane when the model spawns at z = 0. -->
      <link name="base_link">
        <pose>0 0 0.15 0 0 0</pose>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.0417</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.0708</iyy>
            <iyz>0</iyz>
            <izz>0.1042</izz>
          </inertia>
        </inertial>
        <collision name="base_collision">
          <geometry>
            <box>
              <size>0.4 0.3 0.1</size>
            </box>
          </geometry>
        </collision>
        <!-- Front / rear casters: frictionless spheres so the two driven
             wheels fully determine the rover's motion. -->
        <collision name="front_caster_collision">
          <pose>0.15 0 -0.10 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <collision name="rear_caster_collision">
          <pose>-0.15 0 -0.10 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.0</mu>
                <mu2>0.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="base_visual">
          <geometry>
            <box>
              <size>0.4 0.3 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.6 1</ambient>
            <diffuse>0.1 0.3 0.6 1</diffuse>
          </material>
        </visual>
        <visual name="front_caster_visual">
          <pose>0.15 0 -0.10 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <visual name="rear_caster_visual">
          <pose>-0.15 0 -0.10 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.05</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
        <!-- Camera mast (visual only) up to the camera_link offset. -->
        <visual name="camera_mast_visual">
          <pose>0.2 0 0.25 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.01</radius>
              <length>0.45</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.17 0.1 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.00135</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00135</iyy>
            <iyz>0</iyz>
            <izz>0.0025</izz>
          </inertia>
        </inertial>
        <collision name="left_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="left_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.17 0.1 -1.5707963 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia>
            <ixx>0.00135</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00135</iyy>
            <iyz>0</iyz>
            <izz>0.0025</izz>
          </inertia>
        </inertial>
        <collision name="right_wheel_collision">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.5</mu>
                <mu2>1.5</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="right_wheel_visual">
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.05</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
          </material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <use_parent_model_frame>true</use_parent_model_frame>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <use_parent_model_frame>true</use_parent_model_frame>
        </axis>
      </joint>

      <!-- Camera at (0.2, 0.0, 0.5) relative to base_link per the plan doc's
           Step 1.1 spec (base_link origin is at z = 0.15 in the model frame,
           so the link pose below is 0.15 + 0.5). -->
      <link name="camera_link">
        <pose>0.2 0 0.65 0 0 0</pose>
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00001</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>0.00001</iyy>
            <iyz>0</iyz>
            <izz>0.00001</izz>
          </inertia>
        </inertial>
        <visual name="camera_visual">
          <geometry>
            <box>
              <size>0.04 0.08 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <sensor type="camera" name="rover_camera_sensor">
          <update_rate>15.0</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera name="rover_camera">
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100.0</far>
            </clip>
          </camera>
          <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
            <robotNamespace>/</robotNamespace>
            <cameraName>rover2/camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>camera_link</frameName>
          </plugin>
        </sensor>
      </link>

      <joint name="camera_joint" type="fixed">
        <parent>base_link</parent>
        <child>camera_link</child>
      </joint>

      <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
        <robotNamespace>/rover2</robotNamespace>
        <commandTopic>cmd_vel</commandTopic>
        <odometryTopic>odom</odometryTopic>
        <odometryFrame>odom</odometryFrame>
        <odometrySource>world</odometrySource>
        <robotBaseFrame>base_link</robotBaseFrame>
        <leftJoint>left_wheel_joint</leftJoint>
        <rightJoint>right_wheel_joint</rightJoint>
        <wheelSeparation>0.34</wheelSeparation>
        <wheelDiameter>0.2</wheelDiameter>
        <wheelTorque>10.0</wheelTorque>
        <!-- 0 disables the plugin's wheel-speed ramp: commanded velocity is
             applied directly. A nonzero ramp made the rover crawl (~10x
             slower than commanded) under this world's physics settings. -->
        <wheelAcceleration>0.0</wheelAcceleration>
        <updateRate>30.0</updateRate>
        <publishOdomTF>false</publishOdomTF>
        <publishWheelTF>false</publishWheelTF>
        <publishWheelJointState>false</publishWheelJointState>
        <legacyMode>false</legacyMode>
      </plugin>

    </model>

    <!-- Camera rig instances (Universal Simulator Bridge, camera-rover-multi
         phase): one standalone camera_rig per robot, inlined rather than
         <include>d for the same class of reason as the rover models above,
         confirmed empirically 2026-07-23 by a scratch two-<include> test of
         model://camera_rig -- unlike the diff-drive plugin's SDF-level
         "non-unique names" error, this collision is silent: <cameraName> and
         <frameName> are literal strings baked into camera_rig/model.sdf, not
         derived from the <include>'s <name> override, so two <include>s
         produced exactly one /camera_rig/camera/image_raw topic (one
         publisher) feeding from both spawned instances (camera_rig_1,
         camera_rig_2 both showed in /gazebo/model_states) instead of two.
         Regeneration recipe if models/camera_rig/model.sdf changes:
         replacements per instance are model name, cameraName, and frameName
         (see models/camera_rig/model.sdf for the canonical single-robot
         source). Spawned off to the side of each rover's own spawn pose, same
         convention as generic_rover.world -- camera_rig_controller.py moves
         each rig to its own rover's vicinity as soon as it gets a pose from
         that rover's own /roverN/odom. -->
    <model name="camera_rig1">
      <static>true</static>
      <pose>2 4 1 0 0 0</pose>
      <link name="base_link">
        <visual name="rig_visual">
          <geometry>
            <box>
              <size>0.06 0.1 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
        <sensor type="camera" name="camera_rig_sensor">
          <update_rate>10.0</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera name="camera_rig_camera">
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100.0</far>
            </clip>
          </camera>
          <plugin name="camera_rig_controller_plugin" filename="libgazebo_ros_camera.so">
            <robotNamespace>/</robotNamespace>
            <cameraName>camera_rig1/camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>camera_rig1_base_link</frameName>
          </plugin>
        </sensor>
      </link>
    </model>

    <model name="camera_rig2">
      <static>true</static>
      <pose>2 -4 1 0 0 0</pose>
      <link name="base_link">
        <visual name="rig_visual">
          <geometry>
            <box>
              <size>0.06 0.1 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
        <sensor type="camera" name="camera_rig_sensor">
          <update_rate>10.0</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera name="camera_rig_camera">
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>100.0</far>
            </clip>
          </camera>
          <plugin name="camera_rig_controller_plugin" filename="libgazebo_ros_camera.so">
            <robotNamespace>/</robotNamespace>
            <cameraName>camera_rig2/camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>camera_rig2_base_link</frameName>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
