#VRML_SIM R2023a utf8
# Webots quadcopter world for the RBX driver path -- see
# docs/WEBOTS_QUADCOPTER_DRIVER_PLAN.md for why this is a plain
# Supervisor-driven kinematic body (no rotor aerodynamics, no ArduPilot
# SITL, no Physics node at all), not a smaller version of rbx_rover.wbt: the
# Robot node here IS a Supervisor (supervisor TRUE), unlike the rover's,
# specifically so RESET_SIM and direct 3D position control both actually
# work rather than being documented no-ops.
#
# No `physics` block, deliberately: an earlier version used
# Supervisor.setVelocity() on a Physics-enabled body, which turned out to
# fight ODE's own gravity/contact-resolution integration (confirmed live --
# the body fell straight to the floor and then ignored every subsequent
# velocity command, including climb commands, indefinitely). Removed
# Physics entirely and drive the body by directly writing its
# translation/rotation fields each control tick from a position integrated
# in Python (see webots_rbx_bridge_quadcopter.py's applyCommandedVelocity) --
# a plain kinematic body has no gravity to fight and no physics engine to
# silently override our commands. `boundingObject` is kept (harmless without
# a Physics node -- just declares collision geometry for anything that might
# later need to detect this body) but nothing collides with it today.
#
# controller is webots_rbx_bridge_quadcopter, a new file, not a shared one
# with the rover's webots_rbx_bridge (materially different motion model: 3D
# kinematic position integration vs. 2D wheel velocity).

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/objects/floors/protos/Floor.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023a/projects/appearances/protos/Grass.proto"

WorldInfo {
  basicTimeStep 16
  gpsCoordinateSystem "local"
}
Viewpoint {
  orientation -0.25 0.7 0.35 1.1
  position -2.0 -2.5 1.8
}
TexturedBackground {
}
TexturedBackgroundLight {
}
# Grass appearance (default is a grey checkered Parquetry) -- reported live:
# the ground should look the same across every sim, grassy like the Gazebo
# worlds' own Gazebo/Grass ground plane, not grey.
Floor {
  size 10 10
  appearance Grass {
  }
}
Robot {
  translation 0 0 0.3
  supervisor TRUE
  children [
    DEF BODY Shape {
      appearance PBRAppearance {
        baseColor 0.145098 0.309804 0.917647
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.15 0.15 0.05
      }
    }
    # Four arms + rotor caps, visual only -- no HingeJoints/physics rotors.
    # Arm centers at 45 degrees so the whole shape reads as an "X" frame from
    # above, the common quadcopter layout.
    DEF ARM1 Transform {
      translation 0.15 0.15 0
      rotation 0 0 1 0.785398
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.2 0.02 0.02
          }
        }
      ]
    }
    DEF ARM2 Transform {
      translation -0.15 0.15 0
      rotation 0 0 1 -0.785398
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.2 0.02 0.02
          }
        }
      ]
    }
    DEF ARM3 Transform {
      translation -0.15 -0.15 0
      rotation 0 0 1 0.785398
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.2 0.02 0.02
          }
        }
      ]
    }
    DEF ARM4 Transform {
      translation 0.15 -0.15 0
      rotation 0 0 1 -0.785398
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 1
            metalness 0
          }
          geometry Box {
            size 0.2 0.02 0.02
          }
        }
      ]
    }
    DEF ROTOR1 Transform {
      translation 0.25 0.25 0.01
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.917647 0.145098 0.145098
            roughness 1
            metalness 0
          }
          geometry Cylinder {
            height 0.01
            radius 0.06
          }
        }
      ]
    }
    DEF ROTOR2 Transform {
      translation -0.25 0.25 0.01
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.305882 0.898039 0.25098
            roughness 1
            metalness 0
          }
          geometry Cylinder {
            height 0.01
            radius 0.06
          }
        }
      ]
    }
    DEF ROTOR3 Transform {
      translation -0.25 -0.25 0.01
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.917647 0.145098 0.145098
            roughness 1
            metalness 0
          }
          geometry Cylinder {
            height 0.01
            radius 0.06
          }
        }
      ]
    }
    DEF ROTOR4 Transform {
      translation 0.25 -0.25 0.01
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.305882 0.898039 0.25098
            roughness 1
            metalness 0
          }
          geometry Cylinder {
            height 0.01
            radius 0.06
          }
        }
      ]
    }
    GPS {
      name "gps"
    }
    InertialUnit {
      name "imu"
    }
    Camera {
      translation 0.1 0 -0.02
      name "camera"
      width 160
      height 120
    }
  ]
  name "quadcopter"
  boundingObject USE BODY
  controller "webots_rbx_bridge_quadcopter"
}
