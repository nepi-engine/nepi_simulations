<?xml version="1.0"?>

<model>
  <name>Camera Rig Chase</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Numurus</name>
    <email>nepi@numurus.com</email>
  </author>

  <description>
    Second standalone camera-only model, alongside camera_rig, giving the
    ArduPilot SITL quadcopter a genuine chase/scene camera that exists and
    publishes simultaneously with the nose-mounted camera_rig instance --
    added 2026-08-18 to replace the old single-camera_rig-model design,
    where "third-person view" was really just this same one model teleported
    to a different pose on a view_mode toggle (so only one view could ever
    be observed at a time, and a mode switch visibly glitched as the single
    model snapped between poses). Repositioned every frame by
    camera_rig_controller_ardupilot.py via /gazebo/set_model_state, same
    mechanism as camera_rig. Publishes /camera_rig_chase/camera/image_raw,
    distinct from camera_rig's own /camera_rig/camera/image_raw. Built for
    Gazebo Classic 11 / ROS Noetic.
  </description>
</model>
