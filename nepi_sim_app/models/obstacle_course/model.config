<?xml version="1.0"?>

<model>
  <name>Obstacle Course</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Numurus</name>
    <email>nepi@numurus.com</email>
  </author>

  <description>
    Static wall-chicane + ramp course for the generic rover, laid out along
    +x starting a few meters clear of the rover's origin spawn pose so it
    never overlaps a freshly reset rover. One model, since it's spawned and
    deleted as a whole via the /gazebo/spawn_sdf_model and /gazebo/delete_model
    services (sim_bridge_node.py, for the live RUI toggle), in addition to
    being includable directly from generic_rover_obstacle_course.world for
    standalone testing. Built for Gazebo Classic 11 / ROS Noetic.
  </description>
</model>
