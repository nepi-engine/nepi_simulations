<?xml version="1.0"?>

<model>
  <name>Aerial Obstacle Course</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Numurus</name>
    <email>nepi@numurus.com</email>
  </author>

  <description>
    Static sequence of square gate frames climbing along +x, starting a few
    meters clear of the quadcopter's origin spawn pose so it never overlaps a
    freshly reset drone. Each gate is a hollow square frame in the y-z plane;
    a drone flies up-and-through each one in order. One model, since it's
    spawned and deleted as a whole via the /gazebo/spawn_sdf_model and
    /gazebo/delete_model services (sim_bridge_node.py, for the live RUI
    toggle). Built for Gazebo Classic 11 / ROS Noetic.
  </description>
</model>
