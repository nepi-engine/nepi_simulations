<?xml version="1.0"?>

<model>
  <name>Custom Obstacles</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Numurus</name>
    <email>nepi@numurus.com</email>
  </author>

  <description>
    A dynamic, operator-built list of obstacles (walls, circles, triangles)
    instead of a fixed course layout -- see generate_model_sdf.py's
    buildCustomObstaclesSdf and dimensions.yaml's own 'obstacles' list. Built
    and edited live from the "Custom Obstacles" environment config in the
    Sim Connector app's RUI. One model, since it's spawned and deleted as a
    whole via the /gazebo/spawn_sdf_model and /gazebo/delete_model services
    (sim_bridge_node.py, for the live RUI toggle). Built for Gazebo Classic
    11 / ROS Noetic.
  </description>
</model>
