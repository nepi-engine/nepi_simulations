<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="custom_obstacles">
    <!-- Static: pure world geometry, no dynamics needed. Generated by
         generate_model_sdf.py from dimensions.yaml's own 'obstacles' list --
         unlike every other model here, this one has no fixed curated field
         set; edit the list via the "Custom Obstacles" environment config in
         Sim Connector (or hand-edit dimensions.yaml), not this file
         directly, unless using the raw-SDF-upload escape hatch.

         3 obstacle(s) in this course. -->
    <link name="obstacle_0_wall">
      <pose>2.000000 0.000000 0.500000 0 0 0.000000</pose>
      <collision name="collision">
        <geometry><box><size>2.000000 0.200000 1.000000</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>2.000000 0.200000 1.000000</size></box></geometry>
        <material>
          <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script>
        </material>
      </visual>
    </link>

    <link name="obstacle_1_circle">
      <pose>3.500000 0.000000 0.500000 0 0 0</pose>
      <collision name="collision">
        <geometry><cylinder><radius>0.500000</radius><length>1.000000</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.500000</radius><length>1.000000</length></cylinder></geometry>
        <material>
          <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script>
        </material>
      </visual>
    </link>

    <link name="obstacle_2_triangle">
      <pose>5.000000 0.000000 0 0 0 0.000000</pose>
      <collision name="collision">
        <geometry><polyline><point>0 0.500000</point><point>0 -0.500000</point><point>1.000000 0</point><height>1.000000</height></polyline></geometry>
      </collision>
      <visual name="visual">
        <geometry><polyline><point>0 0.500000</point><point>0 -0.500000</point><point>1.000000 0</point><height>1.000000</height></polyline></geometry>
        <material>
          <script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script>
        </material>
      </visual>
    </link>

  </model>
</sdf>
