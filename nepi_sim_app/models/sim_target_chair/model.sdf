<?xml version='1.0'?>
<sdf version="1.6">
  <model name="sim_target_chair">

    <!-- Static, like camera_rig: repositioned every frame by
         ai_targeting_controller_ardupilot.py via /gazebo/set_model_state
         (traces a slow circle), not by a physics joint/plugin -- same
         "no jitter or snap-back" technique already proven for camera_rig. -->
    <static>true</static>

    <link name="base_link">
      <!-- Simple chair-scale box (0.5m x 0.5m footprint, 1.0m tall) -- this
           is a target-detection stand-in, not a visual chair model; only its
           ground-truth pose matters for the simulated range/azimuth/
           elevation feed. -->
      <visual name="chair_visual">
        <geometry>
          <box>
            <size>0.5 0.5 1.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.6 0.3 0.1 1</ambient>
          <diffuse>0.6 0.3 0.1 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
