<?xml version="1.0"?>

<model>
  <name>Sim Target Chair</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Numurus</name>
    <email>nepi@numurus.com</email>
  </author>

  <description>
    Standalone target-object stand-in for the "chair" TARGET_TO_FOLLOW used by
    drone_follow_object_mission_script.py's simulated AI-targeting test.
    Repositioned live by ai_targeting_controller_ardupilot.py via
    /gazebo/set_model_state (same technique as camera_rig) to trace a slow
    circle, giving the ArduPilot SITL drone a genuinely moving object to
    follow. Built for Gazebo Classic 11 / ROS Noetic.
  </description>
</model>
