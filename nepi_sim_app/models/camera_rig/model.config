<?xml version="1.0"?>

<model>
  <name>Camera Rig</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>

  <author>
    <name>Numurus</name>
    <email>nepi@numurus.com</email>
  </author>

  <description>
    Standalone camera-only model for the generic rover's first-person/
    chase-cam view. Not part of generic_rover's kinematic tree -- repositioned
    every frame by camera_rig_controller.py via /gazebo/set_model_state so it
    can follow the rover without fighting a physics joint. Publishes
    /camera_rig/camera/image_raw, distinct from the rover's own
    /rover/camera/image_raw. Built for Gazebo Classic 11 / ROS Noetic.
  </description>
</model>
