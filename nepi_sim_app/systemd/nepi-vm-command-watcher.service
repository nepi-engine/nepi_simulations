# Polls deploy_state.yaml / vm_commands over the nepi_storage CIFS mount
# (nepi-storage-mount.service) and runs whatever launch_command/stop_command/
# install_command/check_installed_command simulator_launch_targets.yaml
# already authors for the SSH path -- see vm_command_watcher.py's own
# docstring for the full protocol. This is what makes a deploy/kill click
# work with NO device-to-VM network path at all (no reverse SSH tunnel
# needed): the device only ever writes into the shared file, this process
# is the only thing that ever executes anything, and it only ever runs
# text this repo's own config already authors.
#
# Prerequisites: nepi-storage-mount.service must be enabled and mounted
# first (Requires=/After= below enforce the ordering, and ExecStartPre
# additionally blocks startup until the mount is actually live, not just
# the unit "started").
#
# Install/refresh:
#   sudo cp nepi-vm-command-watcher.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nepi-vm-command-watcher.service
#
# Check:  systemctl status nepi-vm-command-watcher.service
# Logs:   journalctl -u nepi-vm-command-watcher.service -f

[Unit]
Description=NEPI VM command watcher (sim deploy/kill polling via shared storage)
After=nepi-storage-mount.service network-online.target
Requires=nepi-storage-mount.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# WorkingDirectory=~ (resolves to User='s own home dir, systemd >= 227) --
# without this, a systemd-launched process defaults to cwd=/, which every
# descendant this watcher execs (gzserver, mavproxy, ...) inherits. Confirmed
# live (2026-09-08): mavproxy.py failed outright with "ERROR: opening log
# file for writing: [Errno 13] Permission denied: 'mav.tlog'" because it
# writes that relative path into whatever cwd it inherited, and a non-root
# user can't write to /. Every launch_command in simulator_launch_targets.yaml
# is itself written as "bash -lc '...'", which sources login profile files
# but does NOT itself cd anywhere -- it still needed a sane inherited cwd.
# Runs as the same non-root user that owns the repo checkout and the
# CIFS-mounted files it reads/writes (uid=2000 per nepi_vm_storage_mount.sh's
# own mount options) -- nepi_vm_connect_setup.sh fills this in with
# whichever user actually ran it. NEPI_VM_INSTANCE_ID is this machine's own
# identifier under vm_commands/<instance_id>/ -- must match whatever the
# device's own os_instance_registry has recorded for this machine (the
# setup script picks a sensible default; override here or via the env file
# if the device side used something else).
User=suraj
WorkingDirectory=~
Environment=NEPI_DRONES_REPO_PATH=/home/suraj/nepi_engine_ws/nepi_drones
Environment=NEPI_VM_INSTANCE_ID=baseline
EnvironmentFile=-/etc/nepi-storage-mount.env
ExecStartPre=/bin/bash -c 'until mountpoint -q /mnt/nepi_share_storage; do sleep 2; done'
ExecStart=/usr/bin/python3 ${NEPI_DRONES_REPO_PATH}/sim_container/scripts/vm_command_watcher.py --storage-root /mnt/nepi_share_storage --instance-id ${NEPI_VM_INSTANCE_ID}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
