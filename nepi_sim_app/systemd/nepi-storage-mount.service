# Keeps this machine's /mnt/nepi_share_storage mounted to the NEPI device's
# nepi_storage CIFS share -- the primary deploy/kill transport (see
# vm_command_watcher.py's own docstring: "a real deployment has NO
# device-to-VM network path at all, reverse-tunnel included, so this is not
# a fallback transport, it is THE transport"). A system unit, not a user
# one, since mounting under /mnt requires root -- unlike nepi-tunnel.service,
# which only needs a user's own SSH key.
#
# Prerequisites (see docs/SIM_VM_CONNECTION_SETUP.md for the full
# walkthrough, or run sim_container/scripts/nepi_vm_connect_setup.sh which
# does all of this for you):
#   sudo apt-get install -y cifs-utils
#   sudo tee /etc/nepi_storage_credentials >/dev/null <<'EOF'
#   username=nepi
#   password=nepi
#   EOF
#   sudo chmod 600 /etc/nepi_storage_credentials
#   echo "<device_ip> nepi" | sudo tee -a /etc/hosts   # or use NEPI_DEVICE_SSH_HOST below directly
#
# Install/refresh:
#   sudo cp nepi-storage-mount.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nepi-storage-mount.service
#
# Check:  systemctl status nepi-storage-mount.service ; mountpoint /mnt/nepi_share_storage
# Logs:   journalctl -u nepi-storage-mount.service -f

[Unit]
Description=NEPI shared storage CIFS mount (nepi_storage from the NEPI device)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# NEPI_DEVICE_SSH_HOST here doubles as the CIFS server address -- override
# by dropping a real value in an EnvironmentFile, or just editing this line,
# if the device isn't reachable at its usual static LAN address. Matches
# the same variable name nepi_sitl_dev_env.sh's own nepi_tunnel() and
# nepi-tunnel.service use for the (unrelated) reverse-SSH path, so one
# device IP override covers both mechanisms.
Environment=NEPI_DEVICE_SSH_HOST=192.168.179.103
# NEPI_DRONES_REPO_PATH: this checkout's own location, since a system unit
# has no per-user %h to expand -- nepi_vm_connect_setup.sh fills this in
# with the real path automatically; only a hand-installed unit needs to set
# it manually.
Environment=NEPI_DRONES_REPO_PATH=/home/suraj/nepi_engine_ws/nepi_drones
EnvironmentFile=-/etc/nepi-storage-mount.env
ExecStart=/bin/bash ${NEPI_DRONES_REPO_PATH}/sim_container/scripts/nepi_vm_storage_mount.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
